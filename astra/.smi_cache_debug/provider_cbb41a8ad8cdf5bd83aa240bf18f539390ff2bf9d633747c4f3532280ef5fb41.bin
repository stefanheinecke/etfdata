uot;:&quot;ISSAAITTL&quot;,&quot;ticker&quot;:&quot;SAAI&quot;,&quot;appSubType&quot;:&quot;ISHARES&quot;,&quot;locale&quot;:&quot;en_GB&quot;,&quot;targetSite&quot;:&quot;ishares-uk&quot;,&quot;userType&quot;:&quot;individual&quot;},&quot;additionalComponents&quot;:{},&quot;apiHost&quot;:&quot;https://www.blackrock.com/varnish-api/uk-retail01-product-data/product-data/api/v2/get-product-data?&quot;,&quot;fundName&quot;:&quot;iShares MSCI All Country World Screened UCITS ETF&quot;}" componentkey="performance"><div id="performance" webqc-datapoint="performance" class="fund-component fund-component-container full-bleed" data-id="performance-container" data-componentname="performance" role="region" aria-labelledby="performance-header" tabindex="-1"><div class="container-fluid"><div><h2 data-link-target="" data-id="performance-header" webqc-datapoint="performance-header" id="performance-header"><span>Performance</span></h2></div><div class="performance-main-container row p-0"><div class="performance-returns col-xl-12 col-lg-12 col-md-12 col-sm-12 p-0" role="tabpanel" id="tabpanel-performance-returns" aria-labelledby="tab-performance-returns"><div class="performance-single-tab oneds-blk-heading-xs">RETURNS</div><div webqc-datapoint="activePerformanceTab" role="tabpanel" aria-labelledby="performance-main-tab-returns"><div class="tab-selector-container"><div class="_tableWrapper_1a71w_3"><div class="_scrollShadow_1a71w_17 _left_1a71w_29"></div><div class="_scrollShadow_1a71w_17 _right_1a71w_33"></div><div class="_scrollContainer_1a71w_7"><div class="component-tabs flexible-tabs" role="tablist" data-id="performance-returns-tabs" webqc-datapoint="performance-returns-tabs"><div role="presentation"><button class="oneds-body-l tab Calendar active" role="tab" id="tab-performance-returns-calendar" aria-selected="true" aria-controls="tabpanel-performance-returns-calendar" tabindex="0" data-name="calendar" data-id="performance-returns-calendar-tab" data-text="Calendar Year" data-link-event="performance-returns | tab | open | calendar year"><span class="tab-label" data-text="Calendar Year"><span>Calendar Year</span></span></button></div><div role="presentation"><button class="oneds-body-l tab Discrete" role="tab" id="tab-performance-returns-discrete" aria-selected="false" aria-controls="tabpanel-performance-returns-discrete" tabindex="-1" data-name="discrete" data-id="performance-returns-discrete-tab" data-text="Discrete" data-link-event="performance-returns | tab | open | discrete"><span class="tab-label" data-text="Discrete"><span>Discrete</span></span><span class="info-bubble-container"><button id="infoBubble-86fd7341-1814-4559-943f-d6319322d31f" class="product-info-bubble" aria-haspopup="true" aria-label="More Info: " aria-expanded="false" title="Definition: Discrete annual returns refer to the return that is calculated for each year individually, rather than over a period of time that includes multiple years. The return is not annualised or compounded, but simply the yearly return for each year. Example: If an investment returns 5% in the first year and 7% in the second year, those returns are considered discrete and separate from each other."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></button></div><div role="presentation"><button class="oneds-body-l tab Average" role="tab" id="tab-performance-returns-average" aria-selected="false" aria-controls="tabpanel-performance-returns-average" tabindex="-1" data-name="average" data-id="performance-returns-average-tab" data-text="Annualised" data-link-event="performance-returns | tab | open | annualised"><span class="tab-label" data-text="Annualised"><span>Annualised</span></span><span class="info-bubble-container"><button id="infoBubble-bba12434-6a60-4ce2-8367-7fbf7af582c6" class="product-info-bubble" aria-haspopup="true" aria-label="More Info: " aria-expanded="false" title="Definition: Annualised refers to how a return (or other financial metric) is expressed on a yearly basis, even if the actual period is shorter or longer than one year. It allows investors to compare the performance of investments as if they had been held for a full year. Example: If an investment earned 5% in 6 months, its annualised return would be calculated as if it continued at that rate for 12 months, which would be about 10%."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></button></div><div role="presentation"><button class="oneds-body-l tab Cumulative" role="tab" id="tab-performance-returns-cumulative" aria-selected="false" aria-controls="tabpanel-performance-returns-cumulative" tabindex="-1" data-name="cumulative" data-id="performance-returns-cumulative-tab" data-text="Cumulative" data-link-event="performance-returns | tab | open | cumulative"><span class="tab-label" data-text="Cumulative"><span>Cumulative</span></span><span class="info-bubble-container"><button id="infoBubble-20d9d60e-3607-4992-9cd3-c66b893b6baa" class="product-info-bubble" aria-haspopup="true" aria-label="More Info: " aria-expanded="false" title="Definition: Cumulative refers to the total return on an investment over a specific period, including all gains and losses, without annualising it. It adds up the returns over time, showing the total growth or decline. Example: If an investment grew by 5% in year one and 7% in year two, its cumulative return over those two years would be 12.25% (5% + 7% compounded)."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></button></div></div></div></div></div><div role="tabpanel" id="tabpanel-performance-returns-calendar" aria-labelledby="tab-performance-returns-calendar"><div class="main-disclaimer oneds-body-m missing-data-wrappper calendar-tab calendar-disclaimer"><p>This chart has been left intentionally blank as there is less than one year's performance data.</p></div></div><div class="main-disclaimer oneds-body-m" data-disclaimer-fragment="product-page.performance.disclaimer" data-id="disclaimer-product-page.performance.disclaimer" webqc-datapoint="disclaimer-product-page.performance.disclaimer"><span><p><span class="emphasis">The figures shown relate to past performance. <strong>Past performance is not a reliable indicator of future performance. Markets could develop very differently in the future. It can help you to assess how the fund has been managed in the past</strong></span></p>
<p>Performance is shown on a Net Asset Value (NAV) basis, with gross income reinvested where applicable. Performance data is based on the net asset value (NAV) of the ETF which may not be the same as the market price of the ETF. Individual shareholders may realize returns that are different to the NAV performance.</p>
<p>The return of your investment may increase or decrease as a result of currency fluctuations if your investment is made in a currency other than that used in the past performance calculation. <span class="emphasis">Source:</span> Blackrock</p></span></div></div></div></div></div></div></walrus-render-on-client></div><div data-componentname="displayControlledParagraph"><walrus-render-on-client componenttype="on-server-first" componentprops="{&quot;componentId&quot;:&quot;displayControlledParagraph&quot;,&quot;properties&quot;:{&quot;poiMigrated&quot;:&quot;false&quot;},&quot;containersByNameMap&quot;:{&quot;endDisclaimers&quot;:{&quot;name&quot;:&quot;endDisclaimers&quot;,&quot;fullName&quot;:&quot;displayControlledParagraph.endDisclaimers&quot;,&quot;visible&quot;:true,&quot;sortIndex&quot;:-1,&quot;sortOrder&quot;:null,&quot;properties&quot;:{},&quot;dataPointsByNameMap&quot;:{&quot;product-page.footer.disclaimer&quot;:{&quot;name&quot;:&quot;product-page.footer.disclaimer&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:false,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:9999,&quot;asOfDate&quot;:null,&quot;formattedAsOfDate&quot;:null,&quot;formattedValue&quot;:&quot;-&quot;,&quot;label&quot;:&quot;&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;&quot;,&quot;prefix&quot;:null,&quot;value&quot;:null,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;displayControlledParagraph.endDisclaimers.product-page.footer.disclaimer&quot;}},&quot;hasData&quot;:true,&quot;subContainersByNameMap&quot;:{},&quot;default&quot;:false,&quot;granted&quot;:true},&quot;endDisclaimersBottom&quot;:{&quot;name&quot;:&quot;endDisclaimersBottom&quot;,&quot;fullName&quot;:&quot;displayControlledParagraph.endDisclaimersBottom&quot;,&quot;visible&quot;:true,&quot;sortIndex&quot;:-1,&quot;sortOrder&quot;:null,&quot;properties&quot;:{},&quot;dataPointsByNameMap&quot;: