;:&quot;mstarDataAvailabilityPct&quot;,&quot;visible&quot;:false,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:6,&quot;asOfDate&quot;:null,&quot;formattedAsOfDate&quot;:null,&quot;formattedValue&quot;:&quot;-&quot;,&quot;label&quot;:&quot;&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;&quot;,&quot;prefix&quot;:null,&quot;value&quot;:null,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;ratingsAndAwards.mstarDataAvailabilityPct&quot;},&quot;mstarRatingOverall&quot;:{&quot;name&quot;:&quot;mstarRatingOverall&quot;,&quot;visible&quot;:false,&quot;active&quot;:true,&quot;asOf&quot;:false,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:1,&quot;asOfDate&quot;:null,&quot;formattedAsOfDate&quot;:null,&quot;formattedValue&quot;:&quot;-&quot;,&quot;label&quot;:&quot;Overall&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;{0} received a Morningstar Rating of {5} stars for the 3-year period, {7} for the 5-year period and {9} for the 10-year period, rated against {6}, {8} and {10} {4} Funds, respectively. Performance results represent past performance and are no guarantee of future results.&amp;lt;br /&amp;gt;&amp;lt;br /&amp;gt;For each U.S.-domiciled fund with at least a 3-year history, Morningstar calculates a Morningstar RatingTM based on a Morningstar Risk-Adjusted Return measure that accounts for variation in a fund&amp;#39;s monthly performance (including the effects of sales charges, loads and redemption fees), placing more emphasis on downward variations and rewarding consistent performance. The top 10% of funds in each category receive five stars, the next 22.5% receive four stars, the next 35% receive three stars, the next 22.5% receive two stars and the bottom 10% receive one star. (Each share class is counted as a fraction of one fund within this scale and rated separately, which may cause slight variations in the distribution percentages.) The Overall Morningstar Rating for a fund is derived from a weighted-average of the performance figures associated with its 3-, 5- and 10-year (if applicable) Morningstar Rating metrics.&amp;lt;br /&amp;gt;&amp;lt;br /&amp;gt;Morningstar Ratings are for the share classes cited only; other classes may have different ratings.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:null,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;ratingsAndAwards.mstarRatingOverall&quot;}},&quot;hasData&quot;:true,&quot;subContainersByNameMap&quot;:{},&quot;default&quot;:true,&quot;granted&quot;:true}},&quot;sortOrder&quot;:null,&quot;componentConfig&quot;:{&quot;complianceRules&quot;:[],&quot;default&quot;:{&quot;showMstarRatingUrl&quot;:&quot;false&quot;,&quot;minMstarRating&quot;:&quot;3&quot;,&quot;validMstarAnalystRatings&quot;:&quot;gold,silver,bronze&quot;,&quot;minLipperRating&quot;:&quot;3&quot;,&quot;mstarRatingOverall&quot;:{&quot;name&quot;:&quot;mstarRatingOverall&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:false,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:1,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false},&quot;mstarAnalystRating&quot;:{&quot;name&quot;:&quot;mstarAnalystRating&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:false,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:3,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false},&quot;mstarAnalystDrivenPct&quot;:{&quot;name&quot;:&quot;mstarAnalystDrivenPct&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:5,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false},&quot;mstarDataAvailabilityPct&quot;:{&quot;name